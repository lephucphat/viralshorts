# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Prod GPU: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Transcription backend: whisper (default) | parakeet. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264

# Product analytics (optional, off by default). Both are read by the dashboard
# at BUILD time. Leave them unset and the frontend initialises no analytics and
# loads no third-party script. Set them to your own OpenPanel instance — and add
# your hostname to ANALYTICS_HOSTS in dashboard/index.html — to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# Thumbnail Studio: creative text model (titles, concepts) and the image model.
# Not tied to GEMINI_MODEL on purpose: flash-lite is fine for closed choices,
# visibly worse at titles.
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Moment picker on your own model instead of Gemini (self-host). Any
# OpenAI-compatible chat endpoint: Ollama, LM Studio, vLLM, llama.cpp,
# LocalAI, OpenRouter. With this set the Gemini key is optional; it is still
# used, if present, for the frame-based stages (layout picker, silent videos).
# Ollama needs a context above its 4096 default: OLLAMA_CONTEXT_LENGTH=16384.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_SCORE_BATCH=3
# LLM_TIMEOUT=600

# Hard daily ceiling for the per-GB paid proxy (UTC day, MB). Above it,
# DataImpulse is removed from every chain until midnight and the jobs that
# needed it fail with a clear error. 0 disables the cap. Default 500.
# PAID_PROXY_DAILY_MB=500

# ---------------------------------------------------------------------------
# Privacy, retention and access control (GDPR remediation, 4-sep-2026)
# ---------------------------------------------------------------------------

# Absolute base URL of the API as the internet reaches it. Already used for the
# absolute clip URLs in webhook payloads; now also required to build the
# unsubscribe link that goes in the out-of-minutes email. Without it that email
# falls back to "reply to unsubscribe".
# PUBLIC_API_URL=https://api.YOUR-DOMAIN

# /videos and /thumbnails are authenticated endpoints, not static mounts.
# MEDIA_TOKEN_TTL_SECONDS: life of the per-user token the dashboard appends to
#   <video src> / <img src> URLs (default 43200 = 12 h).
# MEDIA_URL_TTL_SECONDS: life of the path-signed capability handed to consumers
#   that cannot send a header — webhook payloads and MCP tool results
#   (default 86400 = 24 h).
# MEDIA_TOKEN_TTL_SECONDS=43200
# MEDIA_URL_TTL_SECONDS=86400

# Retention for the two kinds of file that had none. Thumbnails and the frames
# sampled to make them are close-ups of a real person; the clock runs from the
# last download. Uploaded actor photos die with the job that used them.
# THUMBNAIL_RETENTION_SECONDS=86400
# ACTOR_UPLOAD_RETENTION_SECONDS=3600

# Throttling is built in and kept in the database (so a restart does not reset it):
# sign-in 8 tries / 10 min per address+IP and 30 / hour per address, 10 sign-ups per
# hour per IP, password checks 8 / 10 min per account, forgot/reset/verify limits,
# and 60 invalid webhook signatures / 10 min per IP. Nothing to configure.

# The container trusts X-Forwarded-For from any hop (the Dockerfile passes "*" to
# uvicorn). That is safe ONLY because docker-compose.prod.yml does not publish the
# backend port: Caddy is the single way in. Never publish port 8000 of this image to
# the internet, or callers can forge the IP the throttles are keyed on.

# HTTPS-only headers (HSTS) are set by Caddy, see the Caddyfile.

# Production switch (docker-compose.prod.yml sets it). With APP_ENV=production the
# server refuses to start unless STUDIO_SECRET is at least 32 random characters, and
# the browser API accepts only https://DOMAIN. CORS_ORIGINS (comma separated) adds
# more allowed origins if you ever serve the dashboard from another host.
# APP_ENV=production
# CORS_ORIGINS=
# Extra throwaway-mail domains to refuse at sign-up (a short built-in list always applies).
# BLOCKED_EMAIL_DOMAINS=

# Encrypted PostgreSQL backups (ops/pg_backup.sh — installed and scheduled on
# the database host, not by the app). The privacy policy promises a deletion is
# gone from every copy within 30 days, which is only true while this runs.
# DATABASE_URL=postgres://user:pass@host:5432/viralshorts
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_DEST=s3://viralshorts-backups/pg
# BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# RETENTION_DAYS=30

# ---- Own accounts: the ViralShorts product mode ---------------------------------
# Turns on sign-up / sign-in, the project library, brand kits and monthly
# minutes (studio/). Independent of the hosted-billing code (BILLING_ENABLED).
# ACCOUNTS_ENABLED=1
# Secret that signs session tokens and media links. Optional on a laptop (one is
# generated on first start and kept in <data dir>/.studio_secret). REQUIRED in
# production: generate with `openssl rand -hex 32`, keep it out of git, and never
# change it without expecting every user to be signed out.
# STUDIO_SECRET=
# SQLite database; uploaded logos live in the same folder (default: ./data).
# Back this folder up. It is deliberately outside output/, which is swept.
# STUDIO_DB_PATH=./data/studio.db
# Minutes of SOURCE video each account may process per month (0 = unlimited).
# STUDIO_MONTHLY_MINUTES=300
# Projects one account may have processing at the same time.
# STUDIO_MAX_ACTIVE_JOBS=2
# People never type third-party keys in this mode; the tools use these:
# GEMINI_API_KEY=...        # clip detection, titles, thumbnails
# FAL_KEY=...               # AI Shorts (actors, B-roll)
# ELEVENLABS_API_KEY=...    # AI Shorts voices, dubbing
# Social publishing is NOT shared: each user pastes their own Upload-Post key
# when they publish, so one account can never post to another's networks.
# ---- Sign in with Google (own accounts) ----------------------------------------
# Both must be set, otherwise the "Continue with Google" button is hidden.
# Google Cloud Console -> APIs & Services: 1) OAuth consent screen (External, app
# name, support email, scopes openid/email/profile); 2) Credentials -> Create
# credentials -> OAuth client ID -> "Web application"; 3) add the callback URL
# below as an Authorized redirect URI; 4) copy the client ID and secret here.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# The exact callback URL registered in Google. Local dev through the Vite proxy:
#   http://localhost:5173/api/auth/google/callback
# Production: https://YOUR-DOMAIN/api/auth/google/callback
# Leave unset only when the API is reached directly on the public address
# (it is then built from PUBLIC_API_URL or the request).
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Only when the dashboard is on a different origin than the API.
# STUDIO_FRONTEND_URL=https://app.example.com

# ---- Paid edition: plans, credits, payments (studio/plans.py, studio/payments/) --
# Needs ACCOUNTS_ENABLED=1. Off by default: with it off, the free monthly
# minutes above apply and no billing route exists.
# 1 credit = 1 minute of source video; other actions cost more (see COSTS in
# studio/plans.py). The server pays the AI APIs, plans and top-ups recover it.
# STUDIO_PAID=1
# Hard ceiling of credits the whole site may spend per UTC day on API-backed
# features, so one incident cannot burn the whole API budget (0 = no ceiling).
# DAILY_AI_BUDGET_CREDITS=2000
# Public address of the dashboard: where payment providers send people back to.
# FRONTEND_URL=https://YOUR-DOMAIN
# Stripe (international cards). Test mode: sk_test_... keys, `stripe listen
# --forward-to localhost:8000/api/stripe/webhook` prints the webhook secret.
# Taking real money needs an account in a country Stripe supports.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PayOS (Vietnamese bank QR). Dashboard: my.payos.vn -> payment channel.
# Webhook URL to register: https://YOUR-DOMAIN/api/payos/webhook
# PAYOS_CLIENT_ID=...
# PAYOS_API_KEY=...
# PAYOS_CHECKSUM_KEY=...

# ---- Email and the admin console (studio/mailer.py, studio/admin.py) ------------
# Without SMTP_HOST nothing is emailed and nothing requires a verified email.
# With it: sign-up confirmation, forgot-password, payment receipts, low-credit
# alerts, and free credits wait until the inbox is confirmed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=no-reply@YOUR-DOMAIN
# SMTP_FROM_NAME=ViralShorts
# REQUIRE_VERIFIED_EMAIL=1      # 0 = send emails but do not hold the free credits
# Operators: a comma-separated list. Each must ALSO have a verified email, so
# whoever registers an admin's address first does not become admin. On a machine
# with no SMTP, mark yours verified with: python -m studio.manage verify you@x.com
# ADMIN_EMAILS=you@example.com
# Print the content of emails to the log when SMTP is not set (development only).
# STUDIO_DEV_MAIL_LOG=1

# ---- Clip library in object storage (studio/archive.py) ------------------------
# Paid plans keep finished clips for their retention (14 / 60 days, plans.py) in an
# S3-compatible bucket: Cloudflare R2, AWS S3, MinIO. They are copied there when a
# project finishes and fetched back when it is opened after the server's own copy
# is gone. Needs STUDIO_PAID=1. All three below switch it on; leave them unset and
# clips only live in output/. Use a PRIVATE bucket: files are served through the app.
# ARCHIVE_BUCKET=viralshorts-clips
# ARCHIVE_ACCESS_KEY_ID=...
# ARCHIVE_SECRET_ACCESS_KEY=...
# R2: https://<accountid>.r2.cloudflarestorage.com   (empty for AWS S3)
# ARCHIVE_ENDPOINT_URL=
# ARCHIVE_REGION=auto
# Files above this size are not archived (the raw source video never is).
# ARCHIVE_MAX_FILE_MB=500

# Keep finished clips long enough for the library to stay useful:
# JOB_RETENTION_SECONDS=604800
